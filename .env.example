# =========================================================================
# Olist Lakehouse M0 — Environment Variables Configuration (.env)
# =========================================================================

# PostgreSQL OLTP Database
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=olist_password
POSTGRES_DB=oltp_olist
POSTGRES_PORT=5432

# MinIO S3-Compatible Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000

# Apache Polaris REST Catalog
POLARIS_PORT=8181

# Trino Distributed Query Engine
TRINO_PORT=8080

# Apache Spark & Jupyter Lab
SPARK_PORT=8888

# Docker Compose Global Namespace
COMPOSE_PROJECT_NAME=olist_lakehouse
